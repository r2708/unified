# unified-code-corpus — credentials & identity.
# This file is gitignored; NEVER commit it. Loaded automatically at startup.
# Precedence: variables already set in your shell > this file > config.yaml.

# --- Hugging Face ------------------------------------------------------------
# Token with WRITE access (create at https://huggingface.co/settings/tokens).
# The same token unlocks the gated sources (bigcode/the-stack-v2,
# bigcode/starcoderdata) once you accept their terms on huggingface.co.
HF_TOKEN=

# Your output dataset repo: "<hf-username-or-org>/<dataset-name>".
# When set, this overrides hf.target_repo from config.yaml.
UCC_TARGET_REPO=

# --- Optional -----------------------------------------------------------------
# Workspace for raw/work/processed shards + manifest (default: ./workspace).
# Point it at a disk with plenty of free space for full-corpus runs.
# UCC_WORKSPACE=/path/with/lots/of/disk

# Upload to a local mock hub instead of the real Hub (dry runs / crash tests).
# UCC_HF_MODE=mock

# --- AWS (ONLY needed for the-stack-v2 content via Software Heritage S3) ------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
